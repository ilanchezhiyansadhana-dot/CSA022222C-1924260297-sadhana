#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define MAX_CANDIDATES 12

typedef struct {
    int id;
    long long votes;
} CandidateResult;

void tally_and_report(const int votes[], int num_votes, int num_candidates, int verbose)
{
    long long counts[MAX_CANDIDATES + 1] = {0};
    long long valid_votes = 0;
    long long invalid_votes = 0;

    for (int i = 0; i < num_votes; i++) {
        int v = votes[i];
        if (v >= 1 && v <= num_candidates) {
            counts[v]++;
            valid_votes++;
        } else {
            invalid_votes++;
        }
    }

    CandidateResult res[MAX_CANDIDATES];
    for (int c = 1; c <= num_candidates; c++) {
        res[c - 1].id = c;
        res[c - 1].votes = counts[c];
    }

    /* Sort descending by vote count (tie-break by candidate ID ascending) */
    for (int i = 0; i < num_candidates - 1; i++) {
        for (int j = 0; j < num_candidates - 1 - i; j++) {
            if (res[j].votes < res[j + 1].votes ||
                (res[j].votes == res[j + 1].votes && res[j].id > res[j + 1].id)) {
                CandidateResult tmp = res[j];
                res[j] = res[j + 1];
                res[j + 1] = tmp;
            }
        }
    }

    long long top_votes = res[0].votes;
    int tie_count = 0;
    for (int i = 0; i < num_candidates; i++) {
        if (res[i].votes == top_votes) tie_count++;
    }

    if (verbose) {
        printf("Valid votes  : %lld\n", valid_votes);
        printf("Invalid votes: %lld\n", invalid_votes);
        printf("Standings (Descending):\n");
        for (int i = 0; i < num_candidates; i++) {
            printf("  Candidate %2d : %lld votes\n", res[i].id, res[i].votes);
        }
        if (tie_count > 1) {
            printf("Result: TIE at %lld votes among candidates:", top_votes);
            for (int i = 0; i < num_candidates; i++) {
                if (res[i].votes == top_votes) printf(" %d", res[i].id);
            }
            printf("\n");
        } else {
            printf("Winner: Candidate %d with %lld votes\n", res[0].id, top_votes);
        }
    }
}

static void benchmark_votes(int num_votes, int num_candidates)
{
    int *votes = malloc((size_t)num_votes * sizeof(int));
    for (int i = 0; i < num_votes; i++) {
        if (i % 25 == 0) votes[i] = 0; /* invalid vote */
        else votes[i] = (i % num_candidates) + 1;
    }

    clock_t t0 = clock();
    tally_and_report(votes, num_votes, num_candidates, 0);
    clock_t t1 = clock();

    printf("Benchmark (%d votes, %d candidates): %.6f s\n",
           num_votes, num_candidates, (double)(t1 - t0) / CLOCKS_PER_SEC);
    free(votes);
}

int main(void)
{
    /* Small test with tie and invalid votes (0, -2, 6) */
    int small_votes[] = {1, 3, 2, 0, 1, 3, -2, 6, 2};
    int n_small = (int)(sizeof small_votes / sizeof small_votes[0]);
    tally_and_report(small_votes, n_small, 5, 1);

    printf("\n");
    benchmark_votes(5000, 12);
    benchmark_votes(500000, 12);
    return 0;
}
