#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int linear_search(const int a[], int n, int key, long long *comps)
{
    *comps = 0;
    for (int i = 0; i < n; i++) {
        (*comps)++;
        if (a[i] == key) return i;
    }
    return -1;
}

int binary_search_count(const int a[], int n, int key, long long *comps)
{
    int low = 0, high = n - 1;
    *comps = 0;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        (*comps)++;
        if (a[mid] == key) return mid;
        else if (a[mid] < key) low = mid + 1;
        else high = mid - 1;
    }
    return -1;
}

static int cmp_int(const void *x, const void *y)
{
    int a = *(const int *)x, b = *(const int *)y;
    return (a > b) - (a < b);
}

int main(void)
{
    int sizes[] = {10, 1000, 10000, 100000};
    srand(42);

    for (int s = 0; s < 4; s++) {
        int n = sizes[s];
        int *unsorted = malloc((size_t)n * sizeof(int));
        int *sorted = malloc((size_t)n * sizeof(int));

        for (int i = 0; i < n; i++) {
            unsorted[i] = (i * 7 + 1000) + (rand() % 5);
            sorted[i] = unsorted[i];
        }
        qsort(sorted, (size_t)n, sizeof(int), cmp_int);

        int test_keys[4] = {
            sorted[0],
            sorted[n / 2],
            sorted[n - 1],
            sorted[n - 1] + 999999 /* missing key */
        };

        printf("\n=== Array Size n = %d ===\n", n);
        for (int t = 0; t < 4; t++) {
            long long c_lin = 0, c_bin = 0;
            int idx_lin = linear_search(unsorted, n, test_keys[t], &c_lin);
            int idx_bin = binary_search_count(sorted, n, test_keys[t], &c_bin);
            printf("Key %d | Linear: idx=%d, comps=%lld | Binary: idx=%d, comps=%lld\n",
                   test_keys[t], idx_lin, c_lin, idx_bin, c_bin);
        }

        free(unsorted);
        free(sorted);
    }
    return 0;
}
